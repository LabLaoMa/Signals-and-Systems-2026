  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Hejw", "[", 
      RowBox[{"w_", ",", "r_", ",", "theta_"}], "]"}], ":=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"2", " ", "r", " ", 
         RowBox[{"Cos", "[", "theta", "]"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "w"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"r", "^", "2"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "2"}], " ", "I", " ", "w"}], "]"}]}]}], ")"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
